{
  "expo": {
    "name": "Rumbo",
    "slug": "rutas-a-tu-medida",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "backgroundColor": "#0E7A43",
    "scheme": "rutasamedida",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/images/icon.png"
    },
    "android": {
      "package": "com.luciacorsan.rutasamedida",
      "adaptiveIcon": {
        "backgroundColor": "#0E7A43",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Permite que Rutas a tu medida use tu ubicación mientras navegas para seguir la ruta y detectar posibles desviaciones."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0E7A43",
          "image": "./assets/images/rumbo-splash.png",
          "imageWidth": 200
        }
      ],
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
